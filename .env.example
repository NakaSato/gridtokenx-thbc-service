# THBC settlement service — copy to .env
#
# NOTE: this service reads `.env` from ITS OWN directory only, and its database
# variable is `THBC_DATABASE_URL`, not `DATABASE_URL`. Both are deliberate. The
# superproject's root `.env` sets `DATABASE_URL` to the shared `gridtokenx`
# database, and a service that picked that up would run its own migrations into
# it — creating `deposits` / `redemptions` tables beside other services' data.

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
# 4000s = gateways, per the repo port scheme. Sits behind APISIX, which
# terminates JWT / mTLS / SSO. Exposing this port directly publishes the admin
# surface — the service does not authenticate requests itself.
THBC_HTTP_PORT=4008

# ---------------------------------------------------------------------------
# Ledger
# ---------------------------------------------------------------------------
# chain-bridge : the real path. Most of the payment leg returns
#                501 not_implemented, because issue_thbc, redeem_thbc_for_fiat,
#                confirm_redemption, reclaim_redemption and the deposit
#                nullifier do not exist in the treasury program (spec §12).
# simulated    : in-memory model of the treasury AS SPECIFIED. Everything works
#                and none of it is real. No chain, no fiat.
THBC_LEDGER_MODE=simulated

# Chain Bridge — the only route to Solana. 9000s = messaging, 5000s = gRPC mesh.
NATS_URL=nats://localhost:9001
CHAIN_BRIDGE_GRPC_URL=http://localhost:5001

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Required in chain-bridge mode; optional in simulated mode (falls back to
# in-memory repositories, which lose every record on restart and with them the
# off-chain half of F3 and the whole F2 tally).
#
# Must be a DEDICATED database. Pointing this at `gridtokenx` is rejected at
# startup. Create it first:
#   createdb -h localhost -p 7001 -U gridtokenx_user gridtokenx_thbc
THBC_DATABASE_URL=postgresql://gridtokenx_user:gridtokenx_password@localhost:7001/gridtokenx_thbc

# Migrations only. `sqlx::migrate!` takes a SESSION-scoped advisory lock, and the
# stack fronts Postgres with pgdog in transaction-pooling mode — where a session's
# connection is handed to other transactions between statements, so the lock can be
# taken on one backend and released against another. Point this at the session-mode
# pooler alias (see docker/pgdog/pgdog.toml in the superproject).
#
# Leave UNSET when connecting straight to Postgres, as local dev and tests do:
# migrations then run on THBC_DATABASE_URL, which is correct with no pooler between.
# Both URLs are checked — neither may name the shared `gridtokenx` database.
#THBC_MIGRATION_DATABASE_URL=postgresql://gridtokenx_user:gridtokenx_password@localhost:7003/gridtokenx_thbc_migrate

# ---------------------------------------------------------------------------
# Invariant parameters
# ---------------------------------------------------------------------------
# Δ — how long a holder waits before reclaiming an unconfirmed redemption (F7).
# 86400 = 24h. Must be positive: zero would make every redemption instantly
# reclaimable, which reads as "F7 implemented" while removing the issuer's
# window entirely.
THBC_REDEMPTION_DELTA_SECS=86400

# Attestation TTL (F5) for the simulated ledger. The real one reads this from
# the treasury account. Past this age, issuance halts until the attestor
# refreshes.
THBC_ATTESTATION_TTL_SECS=3600

# ---------------------------------------------------------------------------
# Simulation only — ignored in chain-bridge mode
# ---------------------------------------------------------------------------
# Starting attested reserve, in THBC minor units (6 decimals).
# 1_000_000_000_000 = 1,000,000 THB.
THBC_SIMULATED_RESERVE_MINOR=1000000000000

# Stub KYC ceiling, in minor units. The stub screener passes deposits at or
# below this and fails those above, so the §5.4 encumbrance path is reachable
# in a simulation. There is no real KYC adapter (spec §12); in chain-bridge
# mode the compliance port refuses every screen rather than auto-passing.
THBC_STUB_KYC_CEILING_MINOR=500000000000

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
RUST_LOG=info,thbc_service=debug,thbc_logic=debug
